<odoo>
    <record model="ir.ui.view" id="spreadsheet_spreadsheet_xlsx_export_form">
        <field name="name">spreadsheet.spreadsheet.xlsx.export.form (in spreadsheet_oca)</field>
        <field name="model">spreadsheet.spreadsheet</field>
        <field name="inherit_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_export_xlsx"
                    type="object"
                    string="Export XLSX"
                    icon="fa-download"
                    class="btn-secondary"
                />
            </xpath>
        </field>
    </record>
</odoo>
