<odoo>
    <!-- ── Search view ───────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_subscription_search_view">
        <field name="name">spreadsheet.subscription.search</field>
        <field name="model">spreadsheet.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="spreadsheet_id" />
                <separator />
                <filter
                    name="daily"
                    string="Daily"
                    domain="[('frequency', '=', 'daily')]"
                />
                <filter
                    name="weekly"
                    string="Weekly"
                    domain="[('frequency', '=', 'weekly')]"
                />
                <filter
                    name="monthly"
                    string="Monthly"
                    domain="[('frequency', '=', 'monthly')]"
                />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="by_spreadsheet"
                        string="Spreadsheet"
                        context="{'group_by': 'spreadsheet_id'}"
                    />
                    <filter
                        name="by_frequency"
                        string="Frequency"
                        context="{'group_by': 'frequency'}"
                    />
                    <filter
                        name="by_partner"
                        string="Subscriber"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ── List view ─────────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_subscription_list_view">
        <field name="name">spreadsheet.subscription.list</field>
        <field name="model">spreadsheet.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-muted="not active">
                <field name="partner_id" />
                <field name="spreadsheet_id" />
                <field name="frequency" />
                <field name="include_pivot_data" />
                <field name="last_sent" />
                <field name="active" column_invisible="True" />
                <button
                    name="action_send_now"
                    type="object"
                    string="Send Now"
                    icon="fa-paper-plane"
                    title="Send digest immediately"
                />
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_subscription_form_view">
        <field name="name">spreadsheet.subscription.form</field>
        <field name="model">spreadsheet.subscription</field>
        <field name="arch" type="xml">
            <form string="Dashboard Subscription">
                <header>
                    <button
                        name="action_send_now"
                        type="object"
                        string="Send Now"
                        class="btn-primary"
                        title="Send digest email immediately"
                    />
                    <field name="active" invisible="1" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Inactive"
                        bg_color="bg-secondary"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="spreadsheet_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="frequency" />
                            <field name="include_pivot_data" />
                            <field name="last_sent" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────── -->
    <record model="ir.actions.act_window" id="spreadsheet_subscription_act_window">
        <field name="name">Dashboard Subscriptions</field>
        <field name="res_model">spreadsheet.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ── Menu item ─────────────────────────────────────────────── -->
    <record model="ir.ui.menu" id="spreadsheet_subscription_menu">
        <field name="name">Dashboard Subscriptions</field>
        <field name="parent_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_configuration_menu" />
        <field name="action" ref="spreadsheet_subscription_act_window" />
        <field name="groups_id" eval="[(4, ref('spreadsheet_oca.group_manager'))]" />
        <field name="sequence" eval="22" />
    </record>

    <!-- ── Smart button on spreadsheet form ─────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_spreadsheet_subscription_button">
        <field name="name">spreadsheet.spreadsheet.form.subscription</field>
        <field name="model">spreadsheet.spreadsheet</field>
        <field name="inherit_id" ref="spreadsheet_oca.spreadsheet_spreadsheet_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_subscriptions"
                    icon="fa-users"
                >
                    <field
                        string="Subscribers"
                        name="subscriber_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
