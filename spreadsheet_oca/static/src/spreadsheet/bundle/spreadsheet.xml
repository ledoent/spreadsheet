<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="spreadsheet_oca.ActionSpreadsheetOca" owl="1">
        <div class="o_spreadsheet_oca_container">
            <SpreadsheetControlPanel record="this.record" />
            <SpreadsheetRenderer
                record="this.record"
                res_id="this.spreadsheetId"
                model="this.model"
                importData="this.importData"
            />
        </div>
    </t>
    <t t-name="spreadsheet_oca.PivotPanel" owl="1">
        <t t-if="this.pivotId">
            <PivotPanelDisplay pivotId="this.pivotId" />
        </t>
        <t t-else="1" />
    </t>
    <t t-name="spreadsheet_oca.PivotPanelDisplay" owl="1">
        <div
            class="h-100 position-relative overflow-x-hidden overflow-y-auto"
            t-ref="this.pivotPanelRef"
        >
            <PivotTitleSectionInsertion
                pivotId="this.props.pivotId"
                flipAxis.bind="this.flipAxis"
            />
            <t t-set="definition" t-value="this.store.definition" />
            <div class="o-section">
                <div class="o-section-title">Model</div>
                <div class="o_model_name"><t t-out="this.modelLabel" /> (<t
                    t-out="definition.model"
                />)</div>
            </div>
            <div class="o-section">
                <div class="o-section-title">Domain</div>
                <DomainSelector
                    resModel="definition.model"
                    domain="this.domain"
                    t-key="'pivot_' + this.props.pivotId"
                />
                <div class="btn btn-link" t-on-click="this.editDomain">
                    Edit domain
                </div>
            </div>
            <PivotLayoutConfiguratorWithAggregators
                unusedGroupableFields="this.store.unusedGroupableFields"
                measureFields="this.store.measureFields"
                unusedGranularities="this.store.unusedGranularities"
                dateGranularities="this.store.dateGranularities"
                datetimeGranularities="this.store.datetimeGranularities"
                definition="definition"
                onDimensionsUpdated.bind="this.updateDimensions"
                getScrollableContainerEl.bind="this.getScrollableContainerEl"
                pivotId="this.props.pivotId"
            />
            <div t-if="definition.sortedColumn" class="o-section">
                <div class="o-section-title">Sorting</div>
                <div t-out="this.sortInformation" />
            </div>
            <div class="o-section o_spreadsheet_oca_pivot_panel_info">
                Last updated at <t t-out="this.lastUpdate" />
            </div>
        </div>
    </t>

    <t t-name="spreadsheet_oca.ListPanel" owl="1">
        <t t-if="this.listId">
            <ListPanelDisplay
                listId="this.listId"
                listDefinition="this.listDefinition"
            />
        </t>
        <t t-else="1" />
    </t>
    <t t-name="spreadsheet_oca.ListPanelDisplay" owl="1">
        <div class="o_spreadsheet_oca_datasource_panel">
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div
                    class="o_spreadsheet_oca_datasource_panel_field_title"
                >List name</div>
                <span
                    t-out="this.env.model.getters.getListDisplayName(this.props.listId)"
                />
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div class="o_spreadsheet_oca_datasource_panel_field_title">Model</div>
                <div><t t-out="this.modelLabel" /> (<t
                    t-out="this.props.listDefinition.model"
                />)</div>
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field">
                <div class="o_spreadsheet_oca_datasource_panel_field_title">Domain</div>
                <DomainSelector
                    resModel="this.props.listDefinition.model"
                    domain="this.domain"
                    t-key="'list_' + this.props.listId"
                />
                <div class="btn btn-link" t-on-click="this.editDomain">
                    Edit domain
                </div>
            </div>
            <div class="o_spreadsheet_oca_datasource_panel_field o-sidePanelButtons">
                <button
                    t-on-click="this.insertList"
                    class="btn btn-success"
                >Insert list</button>
                <button
                    t-on-click="() => this.delete()"
                    class="btn btn-danger"
                >Delete</button>
            </div>
            <div
                class="o_spreadsheet_oca_datasource_panel_field o-sidePanelButtons mt-2 mb-2"
            >
                <label for="list_rows">Rows:</label>
                <input
                    id="list_rows"
                    class="o_input"
                    type="number"
                    t-model.proxy="this.state.listRows"
                    min="1"
                    title="Total rows used when inserting list"
                />
            </div>
            <div class="o_spreadsheet_oca_pivot_panel_info">
                Last updated at <t t-out="this.lastUpdate" />
            </div>
        </div>
    </t>
    <t t-name="spreadsheet_oca.FilterPanel" owl="1">
        <div
            t-foreach="this.env.model.getters.getGlobalFilters()"
            t-as="filter"
            t-key="filter.id"
            class="o_spreadsheet_oca_filter"
        >
            <div class="spreadsheet_oca_filter_label">
                <span t-out="filter.label" />
            </div>
            <div class="spreadsheet_oca_filter_value">
                <FilterValue
                    filter="filter"
                    model="this.env.model"
                    globalFilterValue="this.getGlobalFilterValue(filter.id)"
                    setGlobalFilterValue="(id, value) => this.setGlobalFilterValue(filter.id, value)"
                />
                <i
                    class="oi btn btn-link text-muted spreadsheet_oca_filter_value_edit"
                    data-icon="settings"
                    t-on-click="() => this.onEditFilter(filter)"
                />
            </div>
        </div>
        <div class="o-sidePanelButtons">
            <button
                t-on-click="() => this.onAddFilter('date')"
                class="btn"
            >Add date</button>
            <button
                t-on-click="() => this.onAddFilter('relation')"
                class="btn"
            >Add relation</button>
            <button
                t-on-click="() => this.onAddFilter('text')"
                class="btn"
            >Add text</button>
        </div>
    </t>
    <t t-name="spreadsheet_oca.EditFilterPanel" owl="1">
        <div class="o_spreadsheet_oca_filter">
            <div class="spreadsheet_oca_filter_label">
                <span>Label</span>
            </div>
            <div class="spreadsheet_oca_filter_value">
                <input type="text" t-model.proxy="this.state.label" class="o_input" />
            </div>
        </div>
        <div t-if="this.state.type === 'date'" class="o_spreadsheet_oca_filter">
            <div class="spreadsheet_oca_filter_label">Default value</div>
            <div class="spreadsheet_oca_filter_value">
                <DefaultDateValue
                    value="this.state.defaultValue"
                    update="(value) => this.onDefaultValueChanged(value)"
                />
            </div>
        </div>
        <div t-if="this.state.type === 'text'" class="o_spreadsheet_oca_filter">
            <div class="spreadsheet_oca_filter_label">Default value</div>
            <input
                type="text"
                class="o_input o_global_filter_default_value"
                t-model.proxy="this.state.defaultValue"
            />
        </div>
        <t t-if="this.state.type === 'relation'">
            <div class="o_spreadsheet_oca_filter">
                <div class="spreadsheet_oca_filter_label">Related model</div>
                <div class="spreadsheet_oca_filter_value">
                    <ModelSelector
                        value="this.state.modelData.label or ''"
                        models="this.models"
                        onModelSelected.bind="this.onModelSelected"
                    />
                </div>
                <Checkbox
                    t-if="this.state.modelData.hasParentRelation"
                    name="'includeChildren'"
                    label.translate="Include children"
                    value="this.state.includeChildren"
                    onChange="(value) => this.state.includeChildren = value"
                />
            </div>
            <t t-if="this.state.modelData.technical">
                <div class="o_spreadsheet_oca_filter">
                    <div class="spreadsheet_oca_filter_label">Default value</div>
                    <div
                        t-if="!(this.state.modelData.technical === 'res.users' and this.state.defaultValue === 'current_user')"
                        class="spreadsheet_oca_filter_value"
                    >
                        <MultiRecordSelector
                            resModel="this.state.modelData.technical"
                            resIds="this.state.defaultValue || []"
                            t-key="this.state.modelData.technical"
                            placeholder="''"
                            domain="this.getCorrectDomain()"
                            update.bind="this.onRecordsSelected"
                        />
                    </div>
                    <div
                        t-if="this.state.modelData.technical === 'res.users'"
                        class="spreadsheet_oca_filter_value"
                    >
                        <Checkbox
                            className="'mb-1'"
                            label.translate="Automatically filter on the current user"
                            onChange="(value) => this.state.defaultValue = value ? 'current_user' : []"
                            value="this.state.defaultValue === 'current_user'"
                        />
                    </div>
                </div>
                <div class="o_spreadsheet_oca_filter">
                    <div class="spreadsheet_oca_filter_label">Possible values</div>
                    <div class="spreadsheet_oca_filter_value">
                        <Checkbox
                            className="'mb-1'"
                            label.translate="Restrict values with a domain"
                            onChange.bind="this.changeDomainRestriction"
                            value="this.state.valuesRestricted"
                        />
                    </div>
                    <t t-if="this.state.valuesRestricted">
                        <DomainSelector
                            resModel="this.state.modelData.technical"
                            domain="this.getCorrectDomain()"
                            t-key="'filter_' + this.filterId"
                        />
                        <div class="btn btn-link" t-on-click="this.editDomain">
                            Edit domain
                        </div>
                    </t>
                </div>
            </t>
        </t>
        <div
            t-if="object.model"
            class="o_spreadsheet_oca_filter"
            t-foreach="Object.values(this.state.objects)"
            t-as="object"
            t-key="object.id"
        >
            <div class="spreadsheet_oca_filter_label">
                <span t-out="object.name" /> - <span t-out="object.tag" />
            </div>
            <div class="d-flex justify-content-between">
                <div class="spreadsheet_oca_filter_value flex-column flex-grow-1">
                    <ModelFieldSelector
                        path="this.getModelField(object.fieldMatch)"
                        resModel="object.model"
                        readonly="false"
                        allowEmpty="true"
                        isDebugMode="!!this.env.debug"
                        update="(path, fieldInfo) => this.onFieldMatchUpdate(object, path, fieldInfo)"
                        filter.bind="this.filterModelFieldSelectorField"
                        t-key="object_index"
                    />
                </div>
            </div>

            <div t-if="this.state.type === 'date'" class="spreadsheet_oca_filter_value">
                <select
                    t-model.proxy="object.fieldMatch.offset"
                    t-on-change="(ev) => this.onChangeFieldMatchOffset(object, ev)"
                    class="o_input"
                >
                    <t t-foreach="this.dateOffset" t-as="offset" t-key="offset.value">
                        <option
                            t-att-selected="offset.value === object.fieldMatch.offset ? 1 : 0"
                            t-att-value="offset.value"
                        >
                            <t t-out="offset.name" />
                        </option>
                    </t>
                </select>
            </div>
        </div>
        <div class="o-sidePanelButtons justify-content-center">
            <button t-on-click="this.onRemove" class="btn btn-danger">Remove</button>
            <button t-on-click="this.onCancel" class="btn btn-warning">Cancel</button>
            <button t-on-click="this.onSave" class="btn btn-primary">Save</button>
        </div>
    </t>
    <t t-name="spreadsheet_oca.SpreadsheetRenderer" owl="1">
        <SpreadsheetComponent model="this.spreadsheet_model" />
    </t>
    <t t-name="spreadsheet_oca.SpreadsheetName" owl="1">
        <input
            type="text"
            class="o_spreadsheet_oca_name"
            title="Change name"
            t-att-value="this.state.name"
            t-att-readonly="this.props.isReadonly"
            t-on-change="this._onNameChanged"
        />
        <i t-if="! this.state.name" class="oi text-danger" data-icon="warning" />
        <span
            t-if="! this.state.name"
            class="text-danger o_spreadsheet_oca_name_warning"
        > name is required</span>
    </t>

    <t t-name="spreadsheet_oca.Breadcrumbs.Small" owl="1">
        <ol class="breadcrumb">
            <t t-if="this.breadcrumbs.length > 1">
                <t
                    t-set="breadcrumb"
                    t-value="this.breadcrumbs[this.breadcrumbs.length - 2]"
                />
                <li
                    class="breadcrumb-item o_back_button btn btn-secondary"
                    t-on-click.prevent="() => this.onBreadcrumbClicked(breadcrumb.jsId)"
                />
            </t>
            <li t-if="this.breadcrumbs.length > 0" class="breadcrumb-item active">
                <SpreadsheetName
                    name="this.props.record.name"
                    isReadonly="false"
                    onChanged="this.onSpreadsheetNameChanged"
                />
            </li>
        </ol>
    </t>


    <t t-name="spreadsheet_oca.Breadcrumbs" owl="1">
        <t t-set="currentBreadcrumbs" t-value="this.breadcrumbs.slice(-1)" />
        <t t-set="visiblePathBreadcrumbs" t-value="this.breadcrumbs.slice(-3, -1)" />
        <t
            t-set="collapsedBreadcrumbs"
            t-value="this.breadcrumbs.slice(0, -3).reverse()"
        />
        <t t-set="breadcrumb" t-value="currentBreadcrumbs[0] || {}" />

        <div
            t-if="collapsedBreadcrumbs.length || visiblePathBreadcrumbs.length"
            class="o_breadcrumb d-flex flex-row flex-md-column align-self-stretch justify-content-between min-w-0"
        >
            <t t-if="this.uiService.isSmall">
                <t
                    t-set="previousBreadcrumb"
                    t-value="visiblePathBreadcrumbs.slice(-1)"
                />
                <button
                    class="o_back_button btn btn-link px-1"
                    t-on-click.prevent="() => this.onBreadcrumbClicked(previousBreadcrumb.jsId)"
                >
                    <i class="oi oi-fw oi-arrow-left" />
                </button>
            </t>
            <t t-else="">
                <ol class="breadcrumb flex-nowrap text-nowrap small lh-sm">
                    <li
                        t-if="collapsedBreadcrumbs.length"
                        class="breadcrumb-item d-inline-flex min-w-0"
                    >
                        <Dropdown>
                            <button class="btn btn-light btn-sm px-1 p-0">
                                <i class="oi align-middle" data-icon="more_horiz" />
                            </button>
                            <t t-set-slot="content">
                                <t
                                    t-foreach="collapsedBreadcrumbs"
                                    t-as="breadcrumb"
                                    t-key="breadcrumb.jsId"
                                >
                                    <DropdownItem
                                        onSelected="() => this.onBreadcrumbClicked(breadcrumb.jsId)"
                                    >
                                        <t t-call="web.Breadcrumb.Name" />
                                    </DropdownItem>
                                </t>
                            </t>
                        </Dropdown>
                    </li>
                    <t
                        t-foreach="visiblePathBreadcrumbs"
                        t-as="breadcrumb"
                        t-key="breadcrumb.jsId"
                    >
                        <li
                            class="breadcrumb-item d-inline-flex min-w-0"
                            t-att-class="{ o_back_button: breadcrumb_last }"
                            t-att-data-hotkey="breadcrumb_last and 'b'"
                            t-on-click.prevent="() => this.onBreadcrumbClicked(breadcrumb.jsId)"
                        >
                            <a
                                href="#"
                                class="fw-bold text-truncate"
                                t-att-data-tooltip="'Back to &quot;' + breadcrumb.name + '&quot;'"
                            >
                                <t t-call="web.Breadcrumb.Name" />
                            </a>
                        </li>
                    </t>
                </ol>
            </t>
            <div class="d-flex gap-1 text-truncate">
                <div
                    class="o_last_breadcrumb_item active d-flex gap-2 align-items-center min-w-0 lh-sm"
                >
                    <SpreadsheetName
                        name="this.props.record.name"
                        isReadonly="false"
                        onChanged="this.onSpreadsheetNameChanged"
                    />
                </div>
                <t t-call="web.Breadcrumb.Actions" />
            </div>
        </div>

        <div t-else="" class="o_breadcrumb d-flex gap-1 text-truncate">
            <div
                class="o_last_breadcrumb_item active d-flex fs-4 min-w-0 align-items-center"
            >
                <SpreadsheetName
                    name="this.props.record.name"
                    isReadonly="false"
                    onChanged="this.onSpreadsheetNameChanged"
                />
            </div>
            <t t-call="web.Breadcrumb.Actions" />
        </div>

        <t t-call-slot="control-panel-status-indicator" />
    </t>
    <t t-name="spreadsheet_oca.PivotIcon" owl="1">
        <i class="oi oi-fw" data-icon="table" />
    </t>
    <t t-name="spreadsheet_oca.ListIcon" owl="1">
        <i class="oi oi-fw" data-icon="list" />
    </t>
    <t t-name="spreadsheet_oca.SpreadsheetControlPanel" owl="1">
        <div
            class="o_control_panel d-flex flex-column gap-3 gap-lg-1 px-3 pt-2 pb-3"
            t-ref="this.root"
            data-command-category="actions"
        >
            <div
                class="o_control_panel_main d-flex flex-wrap flex-lg-nowrap justify-content-between align-items-lg-start gap-3 flex-grow-1"
            >
                <div
                    class="o_control_panel_breadcrumbs d-flex align-items-center gap-1 order-0 h-lg-100"
                >
                    <div
                        class="o_control_panel_main_buttons d-flex gap-1 d-empty-none d-print-none"
                    >
                        <div
                            class="btn-group d-xl-none o_control_panel_collapsed_create"
                        >
                            <t t-call-slot="control-panel-create-button" />
                            <button
                                class="btn btn-primary dropdown-toggle dropdown-toggle-split o_control_panel_collapsed_create"
                                t-att-class="{invisible: this.display.disableDropdown}"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                            >
                                <span class="visually-hidden">Toggle Dropdown</span>
                            </button>
                            <ul class="dropdown-menu o_control_panel_collapsed_create">
                                <t t-call-slot="layout-buttons" />
                                <t t-call-slot="control-panel-always-buttons" />
                            </ul>
                        </div>
                        <div class="d-none d-xl-inline-flex gap-1">
                            <t t-call-slot="control-panel-create-button" />
                            <t t-call-slot="layout-buttons" />
                            <t t-call-slot="control-panel-always-buttons" />
                        </div>
                    </div>
                    <t t-if="this.env.config.noBreadcrumbs">
                        <section class="o_control_panel_breadcrumbs_actions d-contents">
                            <t t-call-slot="control-panel-additional-actions" />
                            <t t-call-slot="control-panel-status-indicator" />
                        </section>
                    </t>
                    <t t-else="">
                        <t t-call-slot="control-panel-breadcrumb">
                            <t t-call="spreadsheet_oca.Breadcrumbs" />
                        </t>
                    </t>
                    <span class="d-none d-xl-block me-auto" />
                    <!-- Spacer -->
                </div>

                <div
                    class="o_control_panel_actions d-empty-none d-flex align-items-center justify-content-start justify-content-lg-around order-2 order-lg-1 w-100 w-lg-auto"
                >
                    <t t-if="this.display.layoutActions" t-call-slot="layout-actions" />
                    <t t-call-slot="control-panel-selection-actions" />
                </div>

                <div
                    class="o_control_panel_navigation d-flex flex-wrap flex-md-nowrap justify-content-end gap-3 gap-lg-1 gap-xl-3 order-1 order-lg-2 flex-grow-1"
                >
                    <div
                        t-if="this.pagerProps and this.pagerProps.total > 0"
                        class="o_cp_pager text-nowrap "
                        role="search"
                    >
                        <Pager t-props="this.pagerProps" />
                    </div>
                    <t t-if="this.env.config.viewSwitcherEntries?.length > 1">
                        <Dropdown class="'o_cp_switch_buttons d-xl-none btn-group'">
                            <button class="btn btn-secondary o-dropdown-caret">
                                <t
                                    t-set="activeView"
                                    t-value="this.env.config.viewSwitcherEntries.find((view) => view.active)"
                                />
                                <i class="oi oi-fw" t-att-data-icon="activeView.icon" />
                            </button>
                            <t t-set-slot="content">
                                <t
                                    t-foreach="this.env.config.viewSwitcherEntries"
                                    t-as="view"
                                    t-key="view.type"
                                >
                                    <DropdownItem
                                        onSelected="() => this.switchView(view.type)"
                                        class="view.active ? 'selected' : ''"
                                    >
                                        <i
                                            class="oi oi-fw"
                                            t-att-data-icon="view.icon"
                                        />
                                        <span class="ms-1" t-out="view.name" />
                                    </DropdownItem>
                                </t>
                            </t>
                        </Dropdown>
                        <nav
                            class="o_cp_switch_buttons d-print-none d-none d-xl-inline-flex btn-group"
                        >
                            <t
                                t-foreach="this.env.config.viewSwitcherEntries"
                                t-as="view"
                                t-key="view.type"
                            >
                                <button
                                    class="btn btn-secondary o_switch_view "
                                    t-attf-class="o_{{view.type}} {{view.active ? 'active' : ''}}"
                                    t-att-data-tooltip="view.name"
                                    t-on-click="() => this.switchView(view.type)"
                                >
                                    <i class="oi oi-fw" t-att-data-icon="view.icon" />
                                </button>
                            </t>
                        </nav>
                    </t>
                    <t t-call-slot="control-panel-navigation-additional" />
                </div>
            </div>
        </div>
    </t>
    <t t-name="spreadsheet_oca.OdooPanel" owl="1">
        <div class="o-section">
            <div class="o-section-title">Link to Odoo menu</div>
            <div class="o-section-value">
                <Many2XAutocomplete t-props="this.menuProps" />
            </div>
        </div>
    </t>
    <t
        t-name="spreadsheet_oca.OdooStackablePanel"
        t-inherit="spreadsheet_oca.OdooPanel"
        t-inherit-mode="primary"
        owl="1"
    >
        <xpath expr="div[hasclass('o-section')]" position="before">
            <div class="o-section">
                <label>
                    <div class="o_checkbox">
                        <input
                        type="checkbox"
                        name="stacked"
                        t-att-checked="this.props.definition.stacked"
                        t-on-change="this.onChangeStacked"
                    />
                        Stacked
                    </div>
                </label>
            </div>
        </xpath>
    </t>
    <t t-inherit="o-spreadsheet-GenericChartConfigPanel" t-inherit-mode="extension">
        <xpath expr="//div" position="inside">
            <div class="o-section">
                <div class="o-section-title">Link to Odoo menu</div>
                <div class="o-section-value">
                    <Many2XAutocomplete t-props="this.menuProps" />
                </div>
            </div>
        </xpath>
    </t>
    <t t-inherit="o-spreadsheet-BarConfigPanel" t-inherit-mode="extension">
        <xpath expr="//div" position="inside">
            <div class="o-section">
                <div class="o-section-title">Link to Odoo menu</div>
                <div class="o-section-value">
                    <Many2XAutocomplete t-props="this.menuProps" />
                </div>
            </div>
        </xpath>
    </t>
    <t t-inherit="o-spreadsheet-LineConfigPanel" t-inherit-mode="extension">
        <xpath expr="//div" position="inside">
            <div class="o-section">
                <div class="o-section-title">Link to Odoo menu</div>
                <div class="o-section-value">
                    <Many2XAutocomplete t-props="this.menuProps" />
                </div>
            </div>
        </xpath>
    </t>
    <t t-inherit="o-spreadsheet-GaugeChartConfigPanel" t-inherit-mode="extension">
        <xpath expr="//div" position="inside">
            <div class="o-section">
                <div class="o-section-title">Link to Odoo menu</div>
                <div class="o-section-value">
